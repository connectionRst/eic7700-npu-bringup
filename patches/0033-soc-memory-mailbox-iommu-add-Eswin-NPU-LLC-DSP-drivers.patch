+ */
+#define DRP_WR_D_N2_STRIDE 0x10
+
+/**
+ * @brief For Task 0, the step value in the G2 direction, g2_stride = N2 * N1 * E3 * E2 * E1 * M2 * M1 * F0 * M0 * GF * GMF,
