+}
+
+int es_dsp_pm_get_sync(struct es_dsp *dsp)
+{
+	return 0;
+}
+
+void es_dsp_pm_put_sync(struct es_dsp *dsp)
+{
+	return;
+}
+static int es_dsp_unload_op(struct es_dsp_hw *hw, void *op)
