+		 rdma_and_wig_bitmap);
+	for (i = 0; i < 32; i++) {
+		if ((1 << i) & rdma_and_wig_bitmap) {
+			dla_info("    rdma IFM_WT_CR + %d 0x%x\n", i, *reg++);
