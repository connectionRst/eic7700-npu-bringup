+void reset_uart_mutex(struct es_dsp_hw *hw)
+{
+	if (hw->uart_mutex_base) {
+		writel(0, hw->uart_mutex_base + UART_MUTEX_UNIT_OFFSET);
+	} else {
+		dev_err(&hw->pdev->dev, "uart mutex addr is NULL\n");
+	}
+}
