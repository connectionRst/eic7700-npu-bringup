+#define NPU_HETERO_SEND_FRAME_DONE NPU_HETERO_IOWR(0x02, int)
+#define NPU_HETERO_QUERY_OP_RESUME NPU_HETERO_IOWR(0x03, int)
+#define NPU_HETERO_SEND_OP_DONE NPU_HETERO_IOWR(0x04, int)
