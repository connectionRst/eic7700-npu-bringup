+		nvdla_dev->core_clk = NULL;
+		dev_err(&pdev->dev, "failed to get core clk: %d.\n", ret);
+		return ret;
+	}
+
+	nvdla_dev->llc_aclk = devm_clk_get(&pdev->dev, "clk_npu_llc_aclk");
+	if (IS_ERR(nvdla_dev->llc_aclk)) {
