--- /dev/null
+++ b/drivers/soc/eswin/eswin_noc_sideband_stub.c
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Minimal port of win2030_noc_sideband_mgr_query().
+ *
+ * The vendor implementation (drivers/interconnect/eswin/
+ * win2030_sideband_manager.c) depends on the full Eswin NoC driver, which
+ * is not ported to mainline. When that NoC driver is not initialized the
+ * vendor code already degrades to "report idle":
+ *
+ *     "Win2030 NOC SideBand driver not initialisation, will return idle
+ *      directly!" -> return 1;
+ *
+ * The only mainline consumer (the Eswin NPU driver) calls this to wait for
+ * idle NoC transactions around power-up, so returning 1 (idle) is the
+ * same behavior.
+ */
+
+#include <linux/export.h>
+#include <linux/types.h>
+
+int win2030_noc_sideband_mgr_query(u32 sbm_id)
+{
+	return 1;
+}
+EXPORT_SYMBOL(win2030_noc_sideband_mgr_query);
