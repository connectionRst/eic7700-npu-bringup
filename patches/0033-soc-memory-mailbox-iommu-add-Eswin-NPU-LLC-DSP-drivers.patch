new file mode 100644
index 0000000..f1e2519
--- /dev/null
+++ b/drivers/memory/eswin/es_malloc_dmabuf/es_malloc_dmabuf.c
@@ -0,0 +1,616 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * ESWIN Malloc To DMA-BUF Driver
+ *
