+/* devfreq profile */
+static struct devfreq_dev_profile dsp_devfreq_profile = {
+	.initial_freq = DSP_SUBSYS_HILOAD_CLK,
+	.timer = DEVFREQ_TIMER_DELAYED,
+	.polling_ms = 100, /* Poll every 1000ms to monitor load */
+	.target = dsp_devfreq_target,
