+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Minimal replacement for the vendor Eswin performance-counter clocksource
+ * (drivers/clocksource/timer-eswin.c). The Eswin NPU driver only uses
+ * get_perf_timer_cnt() for per-operation timing logs, so a monotonically
+ * increasing nanosecond counter is sufficient and avoids porting the vendor
+ * clocksource into mainline.
+ */
+
+#include <linux/export.h>
+#include <linux/ktime.h>
+
+u32 get_perf_timer_cnt(u32 numa_id)
+{
+	return (u32)ktime_get_ns();
+}
+EXPORT_SYMBOL(get_perf_timer_cnt);
