+void dsp_devfreq_init(struct es_dsp *dsp)
+{
+	int ret;
+
+	ret = devm_pm_opp_of_add_table(dsp->dev);
+	if (ret) {
+		dev_err(dsp->dev, "Failed to add OPP table, ret:%d\n", ret);
