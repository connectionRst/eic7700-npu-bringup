+typedef enum ipc_message_t {
+	IPC_NONE = 0,
+	IPC_CONFIG0_TRG,  //1
+	IPC_CONFIG1_TRG,  //2
+	IPC_CONFIG0_CPL,  //3
+	IPC_CPNFIG1_CPL,  //4
+	IPC_EVAL0_TRG,	//5
+	IPC_EVAL1_TRG,
+	IPC_MAX_MSG,
