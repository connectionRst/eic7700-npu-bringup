--- /dev/null
+++ b/drivers/soc/eswin/ai_driver/dsp/dsp_hw_if.h
@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * ESWIN AI driver
