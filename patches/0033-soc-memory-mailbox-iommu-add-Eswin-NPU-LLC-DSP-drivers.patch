+}
+
+int dsp_boot_firmware(struct es_dsp *dsp)
+{
+	int ret;
+
+	dsp_halt(dsp);
+	dsp_reset(dsp);
+	reset_uart_mutex((struct es_dsp_hw *)dsp->hw_arg);
+	dsp->off = true;
+
+	if (dsp->firmware_name) {
+		if (loopback < LOOPBACK_NOFIRMWARE) {
+			ret = dsp_request_firmware(dsp);
+			if (ret < 0)
+				return ret;
+		}
+	}
+	dsp_release(dsp);
+	if (loopback < LOOPBACK_NOIO) {
+		ret = dsp_synchronize(dsp);
+		if (ret < 0) {
+			dsp_halt(dsp);
+			dev_err(dsp->dev, "couldn't synchronize with the DSP core\n");
+			dsp_err("es dsp device will not use the DSP until the driver is rebound to this device\n");
+			dsp->off = true;
+			return ret;
+		}
+	}
+	return 0;
+}
+
+int __maybe_unused dsp_suspend(struct device *dev)
+{
+	struct es_dsp *dsp = dev_get_drvdata(dev);
+	int ret;
+	dev_dbg(dev, "%s\n", __func__);
+	if(pm_runtime_status_suspended(dev)) {
+		dev_dbg(dev, "dsp is runtime suspend\n");
+		return 0;
+	}
+
+	ret = wait_event_interruptible_timeout(dsp->event_wq,
+					dsp->current_task == NULL, msecs_to_jiffies(task_timeout));
+	if (ret == 0) {
+        dev_err(dev, "Timeout waiting for task done\n");
+		dsp->off = false;
+        return -ETIMEDOUT;
+    } else if (ret < 0) {
+        dev_err(dev, "Wait error: %d\n", ret);
+		dsp->off = false;
+        return ret;
+    }
+
+	flush_work(&dsp->task_work);
+
+	dsp_disable_irq(dsp);
+
+	dsp_release_firmware(dsp);
+	dsp_halt(dsp);
+
+	win2030_tbu_power(dsp->dev, false);
+
+	es_dsp_clk_disable(dsp);
+	dsp_disable_mbox_clock(dsp);
+
+	dev_dbg(dev, "suspend done.\n");
+	return 0;
+}
+
+int __maybe_unused dsp_resume(struct device *dev)
+{
+	struct es_dsp *dsp = dev_get_drvdata(dev);
+	int ret;
+
+	dev_dbg(dev, "%s\n", __func__);
+	if(pm_runtime_status_suspended(dev)) {
+		dev_dbg(dev, "dsp is runtime suspend\n");
+		return 0;
+	}
+
+	ret = dsp_enable_mbox_clock(dsp);
+	if (ret) {
+		dev_err(dev, "dsp resume mbox clock err.\n");
+		return ret;
+	}
+	ret = es_dsp_clk_enable(dsp);
+	if (ret < 0) {
+		dev_err(dev, "couldn't enable DSP\n");
+		goto out;
+	}
+
+	ret = win2030_tbu_power(dsp->dev, true);
+	if (ret) {
+		dev_err(dev, "tbu power failed, ret=%d\n", ret);
+		goto err_tbu_power;
+	}
+	dsp_enable_irq(dsp);
+	ret = dsp_boot_firmware(dsp);
+	if (ret < 0) {
+		dev_err(dev, "load firmware failed, ret=%d.\n", ret);
+		goto err_firm;
+	}
+
+	dev_dbg(dev, "resume done.\n");
+	dsp->off = false;
+	dsp_schedule_task(dsp);
+	return 0;
+err_firm:
+	win2030_tbu_power(dsp->dev, false);
+err_tbu_power:
+	es_dsp_core_clk_disable(dsp);
+out:
+	dsp_disable_mbox_clock(dsp);
+	return ret;
+}
+
+int __maybe_unused dsp_runtime_suspend(struct device *dev)
+{
+	dev_dbg(dev, "%s\n", __func__);
+
+	return dsp_suspend(dev);
+}
+EXPORT_SYMBOL(dsp_runtime_suspend);
+
+int __maybe_unused dsp_runtime_resume(struct device *dev)
+{
+	dev_dbg(dev, "%s\n", __func__);
+
+	return dsp_resume(dev);
+}
+EXPORT_SYMBOL(dsp_runtime_resume);
