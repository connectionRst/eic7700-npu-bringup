+    SDP_RDMA_D_EW_BASE_ADDR_LOW,
+    SDP_RDMA_D_EW_BASE_ADDR_HIGH,
+    SDP_RDMA_D_EW_LINE_STRIDE,
+    SDP_RDMA_D_EW_SURFACE_STRIDE,
+    SDP_RDMA_D_EW_BATCH_STRIDE,
+    SDP_RDMA_D_FEATURE_MODE_CFG,
+    SDP_RDMA_D_SRC_DMA_CFG,
+    SDP_RDMA_REG_MAX,
+};
+#endif
