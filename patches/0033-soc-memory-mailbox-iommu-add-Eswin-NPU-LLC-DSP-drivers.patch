+struct heap_mem *
+common_dmabuf_heap_import_from_user_with_dma_buf_st(struct heap_root *root,
+						    struct dma_buf *dma_buf)
+{
+	return dmabuf_heap_import_with_dma_buf_st(root, dma_buf);
+}
